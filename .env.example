# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Settings → API Keys.
# Project URL is https://<project-ref>.supabase.co  (the ref is in the
# dashboard URL: /dashboard/project/<project-ref>/…)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The SECRET key (sb_secret_…), NOT the publishable one. Reveal it with the
# eye icon, then copy. It authenticates as the `service_role` Postgres role
# and bypasses RLS, which is what the grants in 0001_schema.sql expect.
# A legacy service_role JWT works in this slot too.
SUPABASE_SECRET_KEY=

# Also required: Settings → Data API → Exposed schemas → add `exp`.
# Without it PostgREST will not route to the schema and every call 404s.

# openssl rand -hex 32   — HMAC key for the rate-limit IP hash.
SESSION_PEPPER=

# openssl rand -hex 32   — Bearer token for GET /api/export.
RESEARCHER_EXPORT_TOKEN=

# openssl rand -base64 32
# Set this in Vercel too. Keeps Server Action references decryptable across
# instances, reducing "Failed to find Server Action" for mid-attempt clients.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
